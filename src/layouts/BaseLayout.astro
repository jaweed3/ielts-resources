---
import "@/styles/globals.css";

export interface Props {
  title: string;
  description?: string;
  activeTab?: string;
}

const { title, description = "IELTS resource hub for mahasiswa", activeTab = "beranda" } = Astro.props;

const SIDEBAR_TABS = [
  { key: "beranda", label: "Dashboard", icon: "dashboard", href: "/" },
  { key: "listening", label: "Listening", icon: "hearing", href: "/listening" },
  { key: "reading", label: "Reading", icon: "menu_book", href: "/reading" },
  { key: "writing", label: "Writing", icon: "edit_note", href: "/writing" },
  { key: "speaking", label: "Speaking", icon: "record_voice_over", href: "/speaking" },
  { key: "grammar", label: "Grammar", icon: "spellcheck", href: "/grammar" },
  { key: "vocabulary", label: "Vocabulary", icon: "dictionary", href: "/vocabulary" },
  { key: "about", label: "About", icon: "info", href: "/about" },
];
---

<!DOCTYPE html>
<html class="dark" lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | IELTS Student Resources</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Special+Elite&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-background text-on-surface font-body min-h-screen antialiased overflow-x-hidden">
    <!-- Grain Overlay -->
    <div class="grain-overlay"></div>

    <!-- Reading Lamp Glow -->
    <div class="reading-lamp-glow fixed inset-0 pointer-events-none z-0 opacity-50"></div>

    <!-- Desktop Sidebar -->
    <aside class="fixed left-0 top-0 z-40 h-screen w-64 bg-surface-container p-4 rounded-r-xl border-r border-outline-variant/20 shadow-md hidden lg:flex lg:flex-col">
      <div class="mb-8 px-4">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-full bg-primary-container flex items-center justify-center shadow-lg">
            <span class="material-symbols-outlined text-on-primary-container" style="font-variation-settings:'FILL'1">auto_stories</span>
          </div>
          <div>
            <h1 class="font-heading font-bold text-[20px] leading-tight text-primary">IELTS Archive</h1>
            <p class="text-on-surface-variant font-medium text-[11px] tracking-widest uppercase">Student Resources</p>
          </div>
        </div>
      </div>

      <nav class="flex-1 space-y-2">
        {SIDEBAR_TABS.slice(0, 7).map((tab) => (
          <a
            href={tab.href}
            class={`flex items-center gap-3 px-4 py-3 rounded-full transition-all duration-200 ${
              activeTab === tab.key
                ? "bg-primary-container text-on-primary-container font-bold scale-95"
                : "text-on-surface-variant hover:bg-surface-variant/50 hover:text-primary"
            }`}
            aria-current={activeTab === tab.key ? "page" : undefined}
          >
            <span class="material-symbols-outlined">{tab.icon}</span>
            <span class="text-base">{tab.label}</span>
          </a>
        ))}
      </nav>

      <div class="h-px bg-outline-variant/10 my-4 mx-4"></div>

      <a
        href="/about"
        class={`flex items-center gap-3 px-4 py-3 rounded-full transition-all duration-200 ${
          activeTab === "about"
            ? "bg-primary-container text-on-primary-container font-bold scale-95"
            : "text-on-surface-variant hover:bg-surface-variant/50 hover:text-primary"
        }`}
      >
        <span class="material-symbols-outlined">info</span>
        <span class="text-base">About</span>
      </a>

      <div class="mt-4 p-4 rounded-xl bg-surface-container-low border border-outline-variant/10">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-primary-container flex items-center justify-center font-heading font-bold text-on-primary-container text-sm">IS</div>
          <div class="overflow-hidden">
            <p class="font-bold text-sm text-on-surface truncate">IELTS Archive</p>
            <a href="mailto:wedjaw22@gmail.com" class="text-[10px] text-on-surface-variant hover:text-primary transition-colors">wedjaw22@gmail.com</a>
          </div>
        </div>
      </div>
    </aside>

    <!-- Main Content Wrapper -->
    <div class="flex flex-col min-h-screen lg:ml-64 relative z-10">
      <!-- Top App Bar -->
      <header class="sticky top-0 z-30 flex items-center justify-between px-margin-mobile lg:px-margin-desktop h-16 lg:h-20 bg-surface/70 backdrop-blur-xl border-b border-outline-variant/10 shadow-sm">
        <div class="flex items-center gap-4 flex-1">
          <!-- Mobile hamburger -->
          <button id="mobile-menu-btn" class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-full text-on-surface-variant hover:bg-surface-variant/30 hover:text-primary transition-colors" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-sidebar">
            <span class="material-symbols-outlined">menu</span>
          </button>

          <!-- Search bar (desktop) -->
          <div class="hidden lg:flex items-center bg-surface-container-high rounded-full px-5 py-2 w-80 border border-outline-variant/10 focus-within:ring-2 focus-within:ring-primary/30 transition-all">
            <span class="material-symbols-outlined text-on-surface-variant mr-3">search</span>
            <input id="global-search" class="bg-transparent border-none focus:ring-0 text-on-surface w-full placeholder:text-on-surface-variant/50 font-body text-sm outline-none" placeholder="Search the archive..." type="text" />
          </div>
        </div>

        <div class="flex items-center gap-4">
          <button class="w-10 h-10 flex items-center justify-center rounded-full text-on-surface-variant hover:bg-surface-variant/30 hover:text-primary transition-colors">
            <span class="material-symbols-outlined">notifications</span>
          </button>
          <button class="w-10 h-10 flex items-center justify-center rounded-full text-on-surface-variant hover:bg-surface-variant/30 hover:text-primary transition-colors">
            <span class="material-symbols-outlined">settings</span>
          </button>
        </div>
      </header>

      <!-- Progress bar -->
      <div id="progress-bar" class="h-0.5 bg-primary shadow-[0_0_8px_rgba(242,202,80,0.5)] transition-all duration-100" style="width:0%"></div>

      <!-- Mobile sidebar overlay -->
      <div id="mobile-overlay" class="fixed inset-0 z-30 hidden bg-black/40 backdrop-blur-sm"></div>

      <!-- Mobile sidebar panel -->
      <aside id="mobile-sidebar" class="fixed inset-y-0 left-0 z-40 w-64 -translate-x-full bg-surface-container shadow-2xl transition-transform duration-200 ease-in-out lg:hidden" role="dialog" aria-modal="true" aria-label="Navigation">
        <div class="flex items-center gap-3 px-6 pt-6 pb-4 mb-6 border-b border-outline-variant/10">
          <div class="w-10 h-10 rounded-full bg-primary-container flex items-center justify-center shadow-lg">
            <span class="material-symbols-outlined text-on-primary-container" style="font-variation-settings:'FILL'1">auto_stories</span>
          </div>
          <div>
            <h2 class="font-heading font-bold text-[18px] leading-tight text-primary">IELTS Archive</h2>
            <p class="text-on-surface-variant font-medium text-[10px] tracking-widest uppercase">Student Resources</p>
          </div>
        </div>

        <nav class="space-y-2 px-4">
          {SIDEBAR_TABS.map((tab) => (
            <a
              href={tab.href}
              class={`flex items-center gap-3 px-4 py-3 rounded-full transition-all duration-200 ${
                activeTab === tab.key
                  ? "bg-primary-container text-on-primary-container font-bold scale-95"
                  : "text-on-surface-variant hover:bg-surface-variant/50 hover:text-primary"
              }`}
            >
              <span class="material-symbols-outlined">{tab.icon}</span>
              <span class="text-base">{tab.label}</span>
            </a>
          ))}
        </nav>

        <div class="absolute bottom-8 left-4 right-4 p-4 rounded-xl bg-surface-container-low border border-outline-variant/10">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-primary-container flex items-center justify-center font-heading font-bold text-on-primary-container text-sm">IS</div>
            <div class="overflow-hidden">
              <p class="font-bold text-sm text-on-surface truncate">IELTS Archive</p>
              <a href="mailto:wedjaw22@gmail.com" class="text-[10px] text-on-surface-variant hover:text-primary transition-colors">wedjaw22@gmail.com</a>
            </div>
          </div>
        </div>
      </aside>

      <!-- Page Content -->
      <main class="flex-1 px-margin-mobile lg:px-margin-desktop py-6 lg:py-10">
        <div class="mx-auto max-w-container-max">
          <slot />
        </div>
      </main>

      <!-- Footer -->
      <footer class="bg-surface-container-lowest border-t border-outline-variant/10 px-margin-mobile lg:px-margin-desktop py-6 lg:py-8">
        <div class="mx-auto max-w-container-max flex flex-col md:flex-row justify-between items-center gap-4">
          <p class="text-sm font-medium text-on-surface-variant">&copy; {new Date().getFullYear()} IELTS Student Resources</p>
          <div class="flex gap-6">
            <a href="mailto:wedjaw22@gmail.com" class="text-sm font-medium text-on-surface-variant hover:text-primary transition-colors underline-offset-4">Contact</a>
            <a href="/about" class="text-sm font-medium text-on-surface-variant hover:text-primary transition-colors underline-offset-4">About</a>
          </div>
        </div>
      </footer>
    </div>

    <script>
      const btn = document.getElementById("mobile-menu-btn");
      const sidebar = document.getElementById("mobile-sidebar");
      const overlay = document.getElementById("mobile-overlay");
      const scrollBar = document.getElementById("progress-bar");
      const searchInput = document.getElementById("global-search");

      function lockScroll() {
        document.body.style.overflow = "hidden";
        document.body.style.position = "fixed";
        document.body.style.width = "100%";
        document.body.style.top = `-${window.scrollY}px`;
      }

      function unlockScroll() {
        const scrollY = parseInt(document.body.style.top || "0") * -1;
        document.body.style.overflow = "";
        document.body.style.position = "";
        document.body.style.width = "";
        document.body.style.top = "";
        window.scrollTo(0, scrollY);
      }

      if (btn && sidebar && overlay) {
        function openMobile() {
          sidebar.classList.remove("-translate-x-full");
          overlay.classList.remove("hidden");
          lockScroll();
          btn.setAttribute("aria-expanded", "true");
          btn.setAttribute("aria-label", "Close menu");
        }
        function closeMobile() {
          sidebar.classList.add("-translate-x-full");
          overlay.classList.add("hidden");
          unlockScroll();
          btn.setAttribute("aria-expanded", "false");
          btn.setAttribute("aria-label", "Open menu");
          btn.focus();
        }
        btn.addEventListener("click", () => {
          const isOpen = !sidebar.classList.contains("-translate-x-full");
          isOpen ? closeMobile() : openMobile();
        });
        overlay.addEventListener("click", closeMobile);
        document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeMobile(); });
        document.querySelectorAll("#mobile-sidebar nav a").forEach(a => a.addEventListener("click", closeMobile));
      }

      if (scrollBar) {
        function updateProgress() {
          const scrollTop = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
          scrollBar.style.width = pct + "%";
        }
        window.addEventListener("scroll", updateProgress, { passive: true });
        window.addEventListener("resize", updateProgress, { passive: true });
        updateProgress();
      }

      if (searchInput) {
        searchInput.addEventListener("keydown", (e) => {
          if (e.key === "Enter") {
            const val = searchInput.value.trim();
            if (val) {
              window.location.href = `/reading?q=${encodeURIComponent(val)}`;
            }
          }
        });
      }
    </script>
  </body>
</html>
