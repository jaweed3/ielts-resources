---
import BaseLayout from "../../layouts/BaseLayout.astro";
import fs from "fs";
import path from "path";

function getReadingType(slug: string, title: string): string {
  const s = slug + " " + title.toLowerCase();
  if (/true.?false|yes.?no|tfng|tru fals not giv/i.test(s)) return "tfng";
  if (/matching/i.test(s)) return "matching";
  if (/mcq|multiple.?choice/i.test(s)) return "mcq";
  if (/completion|diagram|flow.?chart|short.?answer|sentence|table/i.test(s)) return "completion";
  return "general";
}

const READING_TYPES = ["all", "tfng", "matching", "mcq", "completion", "general"];
const READING_LABELS: Record<string, string> = {
  all: "All Types", tfng: "T/F/NG", matching: "Matching", mcq: "MCQ", completion: "Completion", general: "General",
};

const articlesDir = path.join(process.cwd(), "downloaded_resources", "ielts", "reading-tips");
const articleFiles = fs.readdirSync(articlesDir).filter(f => f.endsWith(".md")).sort();

const articles = articleFiles.map((file) => {
  const slug = file.replace(/\.md$/, "");
  const content = fs.readFileSync(path.join(articlesDir, file), "utf-8");
  const titleMatch = content.match(/^#\s+(.+)/m);
  const sourceMatch = content.match(/^source:\s+(.+)/m);
  const title = titleMatch ? titleMatch[1].trim() : slug.replace(/-/g, " ");
  const cleanTitle = title.replace(/^IELTS\s+/i, "");
  const source = sourceMatch ? sourceMatch[1].trim() : "#";
  return { slug, title: cleanTitle || title, source, type: getReadingType(slug, title) };
});

const PER_PAGE = 12;
const totalPages = Math.ceil(articles.length / PER_PAGE);
---

<BaseLayout title="Reading" activeTab="reading">
  <!-- Hero Header -->
  <section class="mb-10">
    <h2 class="font-heading text-3xl md:text-4xl lg:text-display-lg text-on-surface mb-2 tracking-tight">Reading Hub</h2>
    <p class="text-on-surface-variant text-body-lg max-w-2xl">Curated academic texts for high-level comprehension. {articles.length} articles available.</p>
  </section>

  <!-- Search + Filter Controls -->
  <div class="mb-8 space-y-4">
    <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-center justify-between">
      <div class="flex items-center bg-surface-container-high rounded-full px-5 py-2 w-full sm:w-80 border border-outline-variant/10 focus-within:ring-2 focus-within:ring-primary/30 transition-all">
        <span class="material-symbols-outlined text-on-surface-variant mr-3">search</span>
        <input id="search-input" class="bg-transparent border-none focus:ring-0 text-on-surface w-full placeholder:text-on-surface-variant/50 font-body text-sm outline-none" placeholder="Search articles..." type="text" />
      </div>
      <div class="text-on-surface-variant text-sm">
        Showing <span id="showing-label">1-{Math.min(PER_PAGE, articles.length)}</span> of <strong id="total-label" class="text-on-surface">{articles.length}</strong>
      </div>
    </div>

    <div class="flex flex-wrap gap-2">
      {READING_TYPES.map((t) => (
        <button
          class="type-filter px-5 py-2 rounded-full text-label-sm font-bold border transition-all duration-200 active:scale-95"
          data-type={t}
          class-active="bg-primary-container text-on-primary-container border-primary/20"
          class-inactive="bg-surface-container text-on-surface-variant border-outline-variant/20 hover:bg-surface-variant/40"
        >{READING_LABELS[t]}</button>
      ))}
    </div>
  </div>

  <!-- Article Grid -->
  <div id="article-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
    {articles.map((a) => (
      <div class="article-item glass-card rounded-xl overflow-hidden flex flex-col group" data-title={a.title.toLowerCase() + " " + a.slug.replace(/-/g, " ")} data-type={a.type}>
        <div class="p-6 flex-grow flex flex-col">
          <div class="flex items-start justify-between gap-3 mb-3">
            <span class="px-3 py-1 rounded-full bg-secondary-container/30 text-secondary text-[10px] font-bold uppercase tracking-wider">Reading</span>
            <span class="px-3 py-1 rounded-full bg-primary-container/20 text-primary text-[10px] font-bold uppercase tracking-wider">{READING_LABELS[a.type] || a.type}</span>
          </div>
          <h3 class="font-heading text-headline-md text-on-surface mb-3 group-hover:text-primary transition-colors leading-tight">
            <a href={`/reading/article/${a.slug}`} class="hover:text-primary transition-colors">{a.title}</a>
          </h3>
          <div class="mt-auto flex items-center justify-between pt-4 border-t border-outline-variant/10">
            <span class="text-label-sm text-on-surface-variant">{a.source.replace(/^https?:\/\//, "").replace(/\/.*/, "")}</span>
            <a href={`/reading/article/${a.slug}`} class="text-primary font-bold text-label-sm flex items-center gap-1 hover:underline underline-offset-4 tracking-wide">
              OPEN <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Empty State -->
  <div id="empty-result" class="hidden py-16 text-center">
    <span class="material-symbols-outlined text-5xl text-on-surface-variant/30 block mb-4">search_off</span>
    <p class="text-on-surface-variant text-body-lg">No articles match your search or filter.</p>
  </div>

  <!-- Pagination -->
  <div id="pagination" class="mt-10 flex flex-col items-center gap-4">
    <p class="text-label-sm text-on-surface-variant">Page <span id="page-info">1</span> of {totalPages}</p>
    <div class="flex items-center gap-2">
      <button id="prev-page" class="px-5 py-2 rounded-full border border-outline-variant/20 text-on-surface-variant hover:bg-surface-variant/40 transition-all text-label-sm font-bold disabled:opacity-30 disabled:cursor-not-allowed" disabled>
        <span class="material-symbols-outlined">chevron_left</span>
      </button>
      {Array.from({ length: Math.min(totalPages, 7) }, (_, i) => (
        <button class="page-btn w-10 h-10 rounded-full text-label-sm font-bold transition-all duration-200" data-page={i + 1}>{i + 1}</button>
      ))}
      <button id="next-page" class="px-5 py-2 rounded-full border border-outline-variant/20 text-on-surface-variant hover:bg-surface-variant/40 transition-all text-label-sm font-bold disabled:opacity-30 disabled:cursor-not-allowed">
        <span class="material-symbols-outlined">chevron_right</span>
      </button>
    </div>
  </div>

  <script>
    const PER_PAGE = 12;
    const items = document.querySelectorAll(".article-item");
    const pageBtns = document.querySelectorAll(".page-btn");
    const prevBtn = document.getElementById("prev-page");
    const nextBtn = document.getElementById("next-page");
    const searchInput = document.getElementById("search-input");
    const showingLabel = document.getElementById("showing-label");
    const totalLabel = document.getElementById("total-label");
    const pageInfo = document.getElementById("page-info");
    const emptyResult = document.getElementById("empty-result");
    const typeBtns = document.querySelectorAll(".type-filter");
    const activeClass = "bg-primary-container text-on-primary-container border-primary/20";
    const inactiveClass = "bg-surface-container text-on-surface-variant border-outline-variant/20 hover:bg-surface-variant/40";
    let currentPage = 1;
    let activeType = "all";
    let filtered = [];

    function getFiltered() {
      const q = searchInput?.value?.toLowerCase().trim() || "";
      return Array.from(items).filter(el => {
        const matchSearch = !q || el.dataset.title.includes(q);
        const matchType = activeType === "all" || el.dataset.type === activeType;
        return matchSearch && matchType;
      });
    }

    function render() {
      filtered = getFiltered();
      const totalFiltered = filtered.length;

      if (totalFiltered === 0) {
        items.forEach(el => el.style.display = "none");
        document.getElementById("pagination").style.display = "none";
        emptyResult.classList.remove("hidden");
        showingLabel.textContent = "0";
        return;
      }
      emptyResult.classList.add("hidden");
      document.getElementById("pagination").style.display = "";

      const totalPages = Math.ceil(totalFiltered / PER_PAGE);
      if (currentPage > totalPages) currentPage = totalPages;
      const start = (currentPage - 1) * PER_PAGE;
      const end = Math.min(start + PER_PAGE, totalFiltered);

      items.forEach(el => el.style.display = "none");
      filtered.forEach((el, i) => { el.style.display = i >= start && i < end ? "" : "none"; });

      showingLabel.textContent = `${start + 1}-${end}`;
      if (totalLabel) totalLabel.textContent = totalFiltered;
      if (pageInfo) pageInfo.textContent = currentPage;

      prevBtn.disabled = currentPage <= 1;
      nextBtn.disabled = currentPage >= totalPages;

      pageBtns.forEach((btn, i) => {
        const p = i + 1;
        btn.style.display = p <= totalPages ? "" : "none";
        btn.className = `page-btn w-10 h-10 rounded-full text-label-sm font-bold transition-all duration-200 ${
          p === currentPage ? activeClass : inactiveClass
        }`;
        btn.dataset.page = p;
      });
    }

    pageBtns.forEach(btn => btn.addEventListener("click", () => {
      currentPage = parseInt(btn.dataset.page);
      render();
    }));

    if (prevBtn) prevBtn.addEventListener("click", () => {
      if (currentPage > 1) { currentPage--; render(); }
    });

    if (nextBtn) nextBtn.addEventListener("click", () => {
      const totalPages = Math.ceil(filtered.length / PER_PAGE);
      if (currentPage < totalPages) { currentPage++; render(); }
    });

    if (searchInput) searchInput.addEventListener("input", () => { currentPage = 1; render(); });

    typeBtns.forEach(btn => btn.addEventListener("click", () => {
      activeType = btn.dataset.type;
      typeBtns.forEach(b => {
        b.className = `type-filter px-5 py-2 rounded-full text-label-sm font-bold border transition-all duration-200 active:scale-95 ${
          b.dataset.type === activeType ? activeClass : inactiveClass
        }`;
      });
      currentPage = 1;
      render();
    }));

    typeBtns.forEach(b => {
      b.className = `type-filter px-5 py-2 rounded-full text-label-sm font-bold border transition-all duration-200 active:scale-95 ${
        b.dataset.type === "all" ? activeClass : inactiveClass
      }`;
    });

    render();
  </script>
</BaseLayout>
