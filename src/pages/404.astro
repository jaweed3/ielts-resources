---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 Not Found">
  <div class="flex flex-col items-center justify-center py-20 text-center">
    <p class="font-stamp text-8xl font-bold text-muted-foreground/30">404</p>
    <h1 class="mt-4 font-heading text-2xl font-bold text-foreground">Berkas Tidak Ditemukan</h1>
    <p class="mt-2 font-mono text-sm text-muted-foreground">The file you're looking for is not in this dossier.</p>
    <div class="mt-8 inline-flex flex-col items-center justify-center rounded-lg border-[3px] border-dashed border-muted-foreground/30 px-4 py-2 font-stamp uppercase tracking-wider text-muted-foreground/30 opacity-50" style="transform:rotate(-4deg)">
      <span class="text-[11px] leading-tight">STATUS</span>
      <span class="text-lg leading-tight">TIDAK DITEMUKAN</span>
    </div>
    <a href="/" class="mt-8 inline-flex h-10 items-center rounded-lg bg-primary px-6 font-mono text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/80">Back to Dashboard</a>
  </div>
</BaseLayout>
