---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 Not Found">
  <div class="flex flex-col items-center justify-center py-20 text-center">
    <span class="material-symbols-outlined text-8xl text-on-surface-variant/20">folder_off</span>
    <h1 class="mt-4 font-heading text-4xl md:text-5xl font-bold text-on-surface tracking-tight">404</h1>
    <p class="mt-2 text-on-surface-variant text-body-lg">The file you're looking for is not in this archive.</p>
    <div class="mt-6 fallback-stamp inline-flex flex-col items-center p-4 rounded-xl">
      <span class="text-primary/40 font-heading font-bold text-lg tracking-widest uppercase">NOT FOUND</span>
      <span class="text-on-surface-variant text-sm font-medium">TIDAK DITEMUKAN</span>
    </div>
    <a href="/" class="mt-8 inline-flex items-center gap-2 px-6 py-3 bg-primary text-on-primary font-bold rounded-full hover:bg-primary/90 transition-all text-sm active:scale-95">
      <span class="material-symbols-outlined">dashboard</span>
      Back to Dashboard
    </a>
  </div>
</BaseLayout>
