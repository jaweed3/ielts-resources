---
import BaseLayout from "../../layouts/BaseLayout.astro";
import fs from "fs";
import path from "path";

const articlesDir = path.join(process.cwd(), "downloaded_resources", "ielts", "writing-tips");
const articleFiles = fs.readdirSync(articlesDir).filter(f => f.endsWith(".md")).sort();

const articles = articleFiles.map((file) => {
  const slug = file.replace(/\.md$/, "");
  const content = fs.readFileSync(path.join(articlesDir, file), "utf-8");
  const titleMatch = content.match(/^#\s+(.+)/m);
  const sourceMatch = content.match(/^source:\s+(.+)/m);
  const title = titleMatch ? titleMatch[1].trim() : slug.replace(/-/g, " ");
  const cleanTitle = title.replace(/^IELTS\s+/i, "");
  const source = sourceMatch ? sourceMatch[1].trim() : "#";
  const isTask1 = slug.includes("task-1") || slug.includes("task1") || title.toLowerCase().includes("task 1");
  const isTask2 = slug.includes("task-2") || slug.includes("task2") || title.toLowerCase().includes("task 2") || title.toLowerCase().includes("essay");
  return { slug, title: cleanTitle || title, source, task: isTask2 ? "task-2" : isTask1 ? "task-1" : "general" };
});

const PER_PAGE = 10;
const totalPages = Math.ceil(articles.length / PER_PAGE);
const TASK_FILTERS = ["all", "task-1", "task-2", "general"];
const TASK_LABELS: Record<string, string> = { all: "All", "task-1": "Task 1", "task-2": "Task 2", general: "General" };
const TASK_COLORS: Record<string, string> = { "task-1": "bg-amber-50 text-amber-700", "task-2": "bg-purple-50 text-purple-700", general: "bg-muted text-muted-foreground" };
---

<BaseLayout title="Writing" activeTab="writing">
  <div class="mb-6">
    <h1 class="font-heading text-2xl font-bold text-foreground">Writing</h1>
    <p class="mt-1 font-mono text-sm text-muted-foreground">{articles.length} tip articles &middot; ieltsonlinetests.com</p>
  </div>

  <div class="rounded-xl border border-border bg-card shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border/50 px-5 py-3">
      <div class="font-mono text-xs text-muted-foreground">
        Showing <span id="showing-label">1-{Math.min(PER_PAGE, articles.length)}</span> of <strong id="total-label">{articles.length}</strong> articles
      </div>
      <input
        id="search-input"
        type="search"
        placeholder="Search articles..."
        class="h-8 w-48 rounded-md border border-border bg-muted px-3 font-mono text-xs text-foreground/80 placeholder:text-muted-foreground/70 focus:border-blue-400 focus:outline-none focus:ring-1 focus:ring-blue-400"
        aria-label="Search writing articles"
      />
    </div>

    <div class="flex items-center gap-1.5 border-b border-border/50 px-5 py-2">
      {TASK_FILTERS.map((task) => (
        <button class="task-filter inline-flex h-7 items-center rounded-md px-3 font-mono text-[11px] font-medium transition-colors" data-task={task} style={task === "all" ? "background:#1C2B4A;color:#fff" : "color:#8B8060;border:1px solid #DCD2B8;background:#fff"}>
          {TASK_LABELS[task]}
        </button>
      ))}
    </div>

    <div id="article-list" class="divide-y divide-border/50">
      {articles.map((a) => (
        <div class="article-item flex items-center justify-between gap-4 px-5 py-3.5 transition-colors hover:bg-muted" data-title={a.title.toLowerCase() + " " + a.slug.replace(/-/g, " ")} data-task={a.task} style="display:none">
          <div class="min-w-0 flex-1">
            <a href={`/writing/article/${a.slug}`} class="font-heading text-sm font-semibold text-foreground transition-colors hover:text-foreground/80">{a.title}</a>
            <div class="mt-0.5 flex items-center gap-2">
              <span class="inline-flex items-center rounded-md bg-amber-50 px-2 py-0.5 font-mono text-xs font-medium text-amber-700">writing</span>
              <span class={`inline-flex items-center rounded-md px-2 py-0.5 font-mono text-xs font-medium ${TASK_COLORS[a.task] || "bg-muted text-muted-foreground"}`}>{TASK_LABELS[a.task] || a.task}</span>
              <span class="font-mono text-[10px] text-muted-foreground/70">ieltsonlinetests.com</span>
            </div>
          </div>
          <div class="flex shrink-0 items-center gap-1">
            <a href={`/writing/article/${a.slug}`} class="inline-flex h-7 items-center rounded-md bg-primary px-3 font-mono text-[11px] font-medium text-primary-foreground transition-colors hover:bg-primary/80">Read</a>
            <a href={a.source} target="_blank" rel="noopener" class="inline-flex h-7 items-center rounded-md border border-border px-2.5 font-mono text-[11px] text-muted-foreground transition-colors hover:bg-muted">Source</a>
          </div>
        </div>
      ))}
    </div>

    <div id="empty-result" class="hidden px-5 py-12 text-center">
      <p class="font-mono text-sm text-muted-foreground/70">No articles match your search or filter.</p>
    </div>

    <div id="pagination" class="flex items-center justify-center gap-1.5 border-t border-border/50 px-5 py-3">
      {Array.from({ length: totalPages }, (_, i) => (
        <button class="page-btn inline-flex h-7 w-7 items-center justify-center rounded-md font-mono text-xs transition-colors" data-page={i + 1} style={i === 0 ? "background:#1C2B4A;color:#fff" : "color:#8B8060;border:1px solid #DCD2B8"}>{i + 1}</button>
      ))}
    </div>
  </div>

  <script>
    const PER_PAGE = 10;
    const items = document.querySelectorAll(".article-item");
    const pages = document.querySelectorAll(".page-btn");
    const searchInput = document.getElementById("search-input");
    const showingLabel = document.getElementById("showing-label");
    const totalLabel = document.getElementById("total-label");
    const emptyResult = document.getElementById("empty-result");
    const taskBtns = document.querySelectorAll(".task-filter");
    let currentPage = 1;
    let activeTask = "all";
    let filtered = [];

    function getFiltered() {
      const q = searchInput?.value?.toLowerCase().trim() || "";
      return Array.from(items).filter(el => {
        const matchSearch = !q || el.dataset.title.includes(q);
        const matchTask = activeTask === "all" || el.dataset.task === activeTask;
        return matchSearch && matchTask;
      });
    }

    function render() {
      filtered = getFiltered();
      if (filtered.length === 0) {
        items.forEach(el => el.style.display = "none");
        pages.forEach(p => p.style.display = "none");
        if (emptyResult) emptyResult.classList.remove("hidden");
        if (showingLabel) showingLabel.textContent = "0";
        return;
      }
      if (emptyResult) emptyResult.classList.add("hidden");
      pages.forEach(p => p.style.display = "");
      const totalPages = Math.ceil(filtered.length / PER_PAGE);
      if (currentPage > totalPages) currentPage = totalPages;
      const start = (currentPage - 1) * PER_PAGE;
      const end = Math.min(start + PER_PAGE, filtered.length);
      items.forEach(el => el.style.display = "none");
      filtered.forEach((el, i) => { el.style.display = i >= start && i < end ? "" : "none"; });
      if (showingLabel) showingLabel.textContent = `${start + 1}-${end}`;
      if (totalLabel) totalLabel.textContent = filtered.length;
      pages.forEach((btn, i) => {
        const p = i + 1;
        btn.style.display = p <= totalPages ? "inline-flex" : "none";
        const active = p === currentPage;
        btn.style.background = active ? "#1C2B4A" : "#fff";
        btn.style.color = active ? "#fff" : "#8B8060";
        btn.style.borderColor = active ? "#1C2B4A" : "#DCD2B8";
      });
    }

    pages.forEach(btn => btn.addEventListener("click", () => { currentPage = parseInt(btn.dataset.page); render(); }));
    if (searchInput) searchInput.addEventListener("input", () => { currentPage = 1; render(); });
    taskBtns.forEach(btn => btn.addEventListener("click", () => {
      taskBtns.forEach(b => { b.style.background = "#fff"; b.style.color = "#8B8060"; b.style.border = "1px solid #DCD2B8"; });
      btn.style.background = "#1C2B4A"; btn.style.color = "#fff"; btn.style.border = "1px solid #1C2B4A";
      activeTask = btn.dataset.task;
      currentPage = 1;
      render();
    }));
    render();
  </script>
</BaseLayout>
