---
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  return Array.from({ length: 55 }, (_, i) => {
    const n = i + 1;
    const num = String(n).padStart(2, "0");
    return {
      params: { slug: `test-${num}` },
      props: { testNum: num, testNumber: n },
    };
  });
}

const { testNum, testNumber } = Astro.props;
const prevNum = testNumber > 1 ? String(testNumber - 1).padStart(2, "0") : null;
const nextNum = testNumber < 55 ? String(testNumber + 1).padStart(2, "0") : null;
---

<BaseLayout title={`Test ${testNumber}`} description={`IELTS Listening Practice Test ${testNumber}`}>
  <div class="mb-8">
    <a href="/listening" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface-container text-on-surface-variant text-label-sm font-bold hover:bg-surface-variant/40 transition-all mb-6">
      <span class="material-symbols-outlined text-sm">arrow_back</span>
      Back to Tests
    </a>
    <h1 class="font-heading text-3xl md:text-4xl font-bold text-on-surface tracking-tight">IELTS Listening Test {testNumber}</h1>
    <p class="text-on-surface-variant text-body-md mt-2">~30 minutes &middot; 4 sections &middot; 40 questions</p>
  </div>

  <div class="space-y-6">
    <!-- Audio + Download -->
    <div class="glass-card rounded-xl p-6 md:p-8">
      <div class="flex items-center justify-between mb-5">
        <h2 class="font-heading text-xl font-bold text-on-surface flex items-center gap-2">
          <span class="material-symbols-outlined text-primary">headphones</span>
          Audio Player
        </h2>
        <div class="flex gap-2">
          <a href={`/audio/ielts-fever/test-${testNum}.mp3`} download class="px-4 py-2 rounded-full bg-surface-container text-on-surface-variant border border-outline-variant/20 hover:bg-surface-variant/40 transition-all text-label-sm font-bold flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">download</span>
            MP3
          </a>
          <a href={`/audio/ielts-fever/test-${testNum}.pdf`} download class="px-4 py-2 rounded-full bg-surface-container text-on-surface-variant border border-outline-variant/20 hover:bg-surface-variant/40 transition-all text-label-sm font-bold flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">download</span>
            PDF
          </a>
        </div>
      </div>
      <audio controls preload="none" id="audio-player" class="w-full rounded-full" style="height:44px">
        <source src={`/audio/ielts-fever/test-${testNum}.mp3`} type="audio/mpeg" />
      </audio>
    </div>

    <!-- PDF Preview -->
    <div class="glass-card rounded-xl p-6 md:p-8">
      <h2 class="font-heading text-xl font-bold text-on-surface mb-5 flex items-center gap-2">
        <span class="material-symbols-outlined text-primary">description</span>
        Answer Key (PDF)
      </h2>
      <embed src={`/audio/ielts-fever/test-${testNum}.pdf`} type="application/pdf" class="h-[400px] w-full rounded-xl border border-outline-variant/10 sm:h-[500px]" />
    </div>

    <!-- Navigation -->
    <div class="flex items-center justify-between gap-4">
      <div>
        {prevNum ? (
          <a href={`/listening/test-${prevNum}`} class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface-container text-on-surface-variant border border-outline-variant/20 hover:bg-surface-variant/40 transition-all text-label-sm font-bold">
            <span class="material-symbols-outlined text-sm">chevron_left</span>
            Test {parseInt(prevNum)}
          </a>
        ) : (
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface-container text-on-surface-variant/40 border border-outline-variant/10 text-label-sm font-bold cursor-not-allowed">
            <span class="material-symbols-outlined text-sm">chevron_left</span>
            Previous
          </span>
        )}
      </div>
      <a href="/listening" class="inline-flex items-center gap-2 px-5 py-2 rounded-full bg-primary text-on-primary font-bold hover:bg-primary/90 transition-all text-label-sm">
        <span class="material-symbols-outlined text-sm">apps</span>
        All Tests
      </a>
      <div>
        {nextNum ? (
          <a href={`/listening/test-${nextNum}`} class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface-container text-on-surface-variant border border-outline-variant/20 hover:bg-surface-variant/40 transition-all text-label-sm font-bold">
            Test {parseInt(nextNum)}
            <span class="material-symbols-outlined text-sm">chevron_right</span>
          </a>
        ) : (
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface-container text-on-surface-variant/40 border border-outline-variant/10 text-label-sm font-bold cursor-not-allowed">
            Next
            <span class="material-symbols-outlined text-sm">chevron_right</span>
          </span>
        )}
      </div>
    </div>
  </div>

  <script>
    const player = document.getElementById("audio-player");
    if (player) {
      player.addEventListener("play", () => {
        document.querySelectorAll("audio").forEach((el) => {
          if (el !== player && !el.paused) el.pause();
        });
      });
    }
  </script>
</BaseLayout>
