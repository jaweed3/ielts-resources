---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About" activeTab="about">
  <div class="mb-6">
    <h1 class="font-heading text-2xl font-bold text-foreground">About</h1>
    <p class="mt-1 font-mono text-sm text-muted-foreground">IELTS Student Resources</p>
  </div>

  <div class="space-y-6">
    <section class="rounded-xl border border-border bg-card p-6 shadow-sm">
      <h2 class="font-heading text-base font-semibold text-foreground">Purpose</h2>
      <p class="mt-2 font-body text-sm leading-relaxed text-muted-foreground">
        <strong>IELTS Student Resources</strong> is a <strong>fallback archive</strong>.
        It is <em>not</em> the primary learning site. Use it when:
      </p>
      <ul class="mt-2 list-disc space-y-1 pl-5 font-body text-sm leading-relaxed text-muted-foreground">
        <li>The main IELTS learning sites are down or inaccessible.</li>
        <li>You need offline copies of articles and audio for studying without internet.</li>
        <li>You want a lightweight, fast-loading alternative to browse IELTS materials.</li>
      </ul>
      <p class="mt-3 font-body text-sm leading-relaxed text-muted-foreground">
        All materials are sourced from <a href="https://ieltsonlinetests.com" target="_blank" rel="noopener" class="text-foreground underline underline-offset-2">ieltsonlinetests.com</a>
        and <a href="https://ieltsfever.org" target="_blank" rel="noopener" class="text-foreground underline underline-offset-2">IELTS Fever</a>.
        This archive provides offline copies so students can keep studying even
        with limited internet connectivity.
      </p>
    </section>

    <section class="rounded-xl border border-border bg-card p-6 shadow-sm">
      <h2 class="font-heading text-base font-semibold text-foreground">Archive Contents</h2>
      <div class="mt-3 overflow-x-auto">
        <table class="w-full font-mono text-xs">
          <thead>
            <tr class="border-b border-border">
              <th class="px-2 py-1.5 text-left font-medium text-muted-foreground">Category</th>
              <th class="px-2 py-1.5 text-left font-medium text-muted-foreground">Files</th>
              <th class="px-2 py-1.5 text-left font-medium text-muted-foreground">Source</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-border/50"><td class="px-2 py-1.5">Listening Practice Tests</td><td class="px-2 py-1.5">55 MP3 + 30 PDF</td><td class="px-2 py-1.5">IELTS Fever</td></tr>
            <tr class="border-b border-border/50"><td class="px-2 py-1.5">Listening Tips</td><td class="px-2 py-1.5">22 articles</td><td class="px-2 py-1.5">ieltsonlinetests.com</td></tr>
            <tr class="border-b border-border/50"><td class="px-2 py-1.5">Reading Tips</td><td class="px-2 py-1.5">41 articles</td><td class="px-2 py-1.5">ieltsonlinetests.com</td></tr>
            <tr><td class="px-2 py-1.5">Writing Tips</td><td class="px-2 py-1.5">64 articles</td><td class="px-2 py-1.5">ieltsonlinetests.com</td></tr>
          </tbody>
        </table>
      </div>
      <p class="mt-3 font-mono text-xs text-muted-foreground/70">Speaking, Grammar, Vocabulary — in progress</p>
    </section>

    <section class="rounded-xl border border-border bg-card p-6 shadow-sm">
      <h2 class="font-heading text-base font-semibold text-foreground">Technical</h2>
      <div class="mt-3 space-y-1 font-mono text-xs text-muted-foreground">
        <p>Framework: Astro (static site)</p>
        <p>Styling: Tailwind CSS</p>
        <p>Fonts: Inter, JetBrains Mono, Special Elite</p>
        <p>Status: MVP &mdash; 278 static pages</p>
      </div>
    </section>

    <section class="rounded-xl border border-border bg-card p-6 shadow-sm">
      <h2 class="font-heading text-base font-semibold text-foreground">Disclaimer</h2>
      <div class="mt-3 rounded-lg border-l-4 border-l-blue-500 bg-muted px-4 py-3 font-mono text-xs leading-relaxed text-muted-foreground">
        This site is a personal archive for educational purposes. All copyrights remain
        with the original owners (IELTS Fever and ieltsonlinetests.com). If you are a
        copyright holder and object to any material displayed, please contact us for
        immediate removal.
      </div>
    </section>

    <section class="rounded-xl border border-border bg-card p-6 text-center shadow-sm">
      <h2 class="font-heading text-base font-semibold text-foreground">Contact</h2>
      <p class="mt-1 font-mono text-sm text-muted-foreground">Suggestions, criticism, or feedback?</p>
      <a href="mailto:wedjaw22@gmail.com" class="mt-2 inline-block font-mono text-sm text-foreground underline underline-offset-2">wedjaw22@gmail.com</a>
      <div class="mt-4 inline-flex flex-col items-center justify-center rounded-lg border-[3px] border-blue-800 px-4 py-2 font-stamp uppercase tracking-wider text-blue-800 shadow-[inset_0_0_0_1px_currentColor]" style="transform:rotate(-2deg)">
        <span class="text-[11px] leading-tight">STATUS</span>
        <span class="text-base leading-tight">READY TO USE</span>
      </div>
    </section>
  </div>
</BaseLayout>
