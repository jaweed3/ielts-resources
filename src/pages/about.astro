---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About" activeTab="about">
  <div class="mb-10">
    <h2 class="font-heading text-3xl md:text-4xl lg:text-display-lg text-on-surface mb-2 tracking-tight">About</h2>
    <p class="text-on-surface-variant text-body-lg max-w-2xl">IELTS Student Resources — fallback archive for uninterrupted study.</p>
  </div>

  <div class="space-y-6 max-w-3xl">
    <section class="glass-card p-8 rounded-xl">
      <h3 class="font-heading text-2xl font-bold text-on-surface mb-4 flex items-center gap-3">
        <span class="material-symbols-outlined text-primary">info</span>
        Purpose
      </h3>
      <p class="text-on-surface-variant text-body-md leading-relaxed">
        <strong class="text-on-surface">IELTS Student Resources</strong> is a <strong class="text-on-surface">fallback archive</strong>.
        It is <em>not</em> the primary learning site. Use it when the main IELTS learning sites are down or
        if you need offline copies of articles and audio for studying without internet.
      </p>
      <ul class="mt-4 space-y-2">
        <li class="flex items-start gap-3 text-on-surface-variant text-body-md">
          <span class="material-symbols-outlined text-primary text-sm mt-0.5">cloud_off</span>
          <span>Primary sites are down or inaccessible</span>
        </li>
        <li class="flex items-start gap-3 text-on-surface-variant text-body-md">
          <span class="material-symbols-outlined text-primary text-sm mt-0.5">file_download</span>
          <span>Need offline copies for studying without internet</span>
        </li>
        <li class="flex items-start gap-3 text-on-surface-variant text-body-md">
          <span class="material-symbols-outlined text-primary text-sm mt-0.5">bolt</span>
          <span>Want a lightweight, fast-loading alternative to browse materials</span>
        </li>
      </ul>
    </section>

    <section class="glass-card p-8 rounded-xl">
      <h3 class="font-heading text-2xl font-bold text-on-surface mb-4 flex items-center gap-3">
        <span class="material-symbols-outlined text-primary">inventory_2</span>
        Archive Contents
      </h3>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-outline-variant/20">
              <th class="px-3 py-2 text-left text-label-sm text-on-surface-variant font-bold">Category</th>
              <th class="px-3 py-2 text-left text-label-sm text-on-surface-variant font-bold">Files</th>
              <th class="px-3 py-2 text-left text-label-sm text-on-surface-variant font-bold">Source</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-outline-variant/10"><td class="px-3 py-2 text-on-surface">Listening Practice Tests</td><td class="px-3 py-2 text-on-surface-variant">55 MP3 + 30 PDF</td><td class="px-3 py-2 text-on-surface-variant">IELTS Fever</td></tr>
            <tr class="border-b border-outline-variant/10"><td class="px-3 py-2 text-on-surface">Listening Tips</td><td class="px-3 py-2 text-on-surface-variant">22 articles</td><td class="px-3 py-2 text-on-surface-variant">ieltsonlinetests.com</td></tr>
            <tr class="border-b border-outline-variant/10"><td class="px-3 py-2 text-on-surface">Reading Tips</td><td class="px-3 py-2 text-on-surface-variant">41 articles</td><td class="px-3 py-2 text-on-surface-variant">ieltsonlinetests.com</td></tr>
            <tr class="border-b border-outline-variant/10"><td class="px-3 py-2 text-on-surface">Writing Tips</td><td class="px-3 py-2 text-on-surface-variant">64 articles</td><td class="px-3 py-2 text-on-surface-variant">ieltsonlinetests.com</td></tr>
            <tr class="border-b border-outline-variant/10"><td class="px-3 py-2 text-on-surface">Speaking Tips</td><td class="px-3 py-2 text-on-surface-variant">36 articles</td><td class="px-3 py-2 text-on-surface-variant">ieltsonlinetests.com</td></tr>
            <tr class="border-b border-outline-variant/10"><td class="px-3 py-2 text-on-surface">Grammar</td><td class="px-3 py-2 text-on-surface-variant">30 articles</td><td class="px-3 py-2 text-on-surface-variant">ieltsonlinetests.com</td></tr>
            <tr><td class="px-3 py-2 text-on-surface">Vocabulary</td><td class="px-3 py-2 text-on-surface-variant">20 articles</td><td class="px-3 py-2 text-on-surface-variant">ieltsonlinetests.com</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="glass-card p-8 rounded-xl">
      <h3 class="font-heading text-2xl font-bold text-on-surface mb-4 flex items-center gap-3">
        <span class="material-symbols-outlined text-primary">terminal</span>
        Technical
      </h3>
      <div class="space-y-2 text-on-surface-variant text-body-md">
        <p><span class="text-primary">Framework:</span> Astro (static site)</p>
        <p><span class="text-primary">Styling:</span> Tailwind CSS</p>
        <p><span class="text-primary">Fonts:</span> Bricolage Grotesque, Inter, JetBrains Mono, Special Elite</p>
        <p><span class="text-primary">Status:</span> MVP — 278 static pages</p>
      </div>
    </section>

    <section class="glass-card p-8 rounded-xl">
      <h3 class="font-heading text-2xl font-bold text-on-surface mb-4 flex items-center gap-3">
        <span class="material-symbols-outlined text-primary">gavel</span>
        Disclaimer
      </h3>
      <div class="p-4 rounded-xl bg-surface-container-low border border-outline-variant/10 text-on-surface-variant text-body-md leading-relaxed">
        This site is a personal archive for educational purposes. All copyrights remain
        with the original owners (IELTS Fever and ieltsonlinetests.com). If you are a
        copyright holder and object to any material displayed, please contact us for
        immediate removal.
      </div>
    </section>

    <section class="glass-card p-8 rounded-xl text-center">
      <h3 class="font-heading text-2xl font-bold text-on-surface mb-2 flex items-center justify-center gap-3">
        <span class="material-symbols-outlined text-primary">mail</span>
        Contact
      </h3>
      <p class="text-on-surface-variant text-body-md mb-4">Suggestions, criticism, or feedback?</p>
      <a href="mailto:wedjaw22@gmail.com" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-on-primary font-bold rounded-full hover:bg-primary/90 transition-all text-sm">
        <span class="material-symbols-outlined">send</span>
        wedjaw22@gmail.com
      </a>
      <div class="mt-8 fallback-stamp inline-flex flex-col items-center p-4 rounded-xl">
        <span class="text-primary/40 font-heading font-bold text-lg tracking-widest uppercase">STATUS</span>
        <span class="text-on-surface-variant text-sm font-medium">READY TO USE</span>
      </div>
    </section>
  </div>
</BaseLayout>
